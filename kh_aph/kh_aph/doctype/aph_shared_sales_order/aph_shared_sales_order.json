{
  "doctype": "DocType",
  "name": "APH Shared Sales Order",
  "module": "Kh Aph",
  "custom": 0,
  "istable": 0,
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "customer",
      "label": "Khách hàng",
      "fieldtype": "Link",
      "options": "Customer",
      "reqd": 1
    },
    {
      "fieldname": "transaction_date",
      "label": "Ngày đặt",
      "fieldtype": "Date",
      "default": "Today",
      "reqd": 1
    },
    {
      "fieldname": "delivery_date",
      "default": "Today",
      "label": "Ngày giao dự kiến",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "selling_price_list",
      "label": "Bảng giá bán",
      "fieldtype": "Link",
      "options": "Price List",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "label": "Tiền tệ",
      "fieldtype": "Link",
      "options": "Currency",
      "default": "VND",
      "reqd": 1
    },
    {
      "fieldname": "items",
      "label": "Hàng bán",
      "fieldtype": "Table",
      "options": "APH Shared Sales Order Item",
      "reqd": 1
    },
    {
      "fieldname": "net_total",
      "label": "Tổng giá trị hàng",
      "fieldtype": "Currency",
      "read_only": 1,
      "description": "Tổng số lượng kg × giá bán/kg. Thuế được tính trên đơn bán của từng đơn vị."
    }
  ],
  "field_order": [
    "customer",
    "transaction_date",
    "delivery_date",
    "selling_price_list",
    "currency",
    "items",
    "net_total"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "print": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "print": 1
    },
    {
      "role": "Nhân viên bán hàng",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "print": 1
    },
    {
      "role": "Thủ kho bán hàng",
      "read": 1,
      "print": 1
    }
  ],
  "autoname": "format:APH-SO-{YYYY}-{#####}"
}
